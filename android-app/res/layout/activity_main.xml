<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/green_dark"
        android:titleTextColor="#ffffff"
        android:titleTextAppearance="@style/ToolbarTitle"
        android:title="@string/app_name" />

    <LinearLayout
        android:id="@+id/updateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/warn_bg"
        android:padding="10dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/updateText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/warn_text"
            android:textSize="14sp" />
        <Button
            android:id="@+id/updateBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/btn_primary"
            android:elevation="2dp"
            android:textColor="#ffffff"
            android:text="আপডেট করুন (Update)"
            android:textSize="13sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/updateDismiss"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/btn_ghost"
            android:textColor="@color/text_dark"
            android:text="✕"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Compact hero: NO big heading line (removed — the user asked for it
         gone). Only the two info lines, kept small and clean: stats +
         refresh in one row, and the countdown below it (2 lines allowed,
         11sp, so the nearest-deadline line is never cut off mid-way).
         Circulars are the main thing, so the header stays short and the
         list starts high. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/green_dark"
        android:padding="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/heroStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#d1fae5"
                android:textSize="12sp" />
            <Button
                android:id="@+id/refreshBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/drawer_close_bg"
                android:textColor="#ffffff"
                android:text="⟳"
                android:textSize="16sp"
                android:contentDescription="এখনই নতুন সার্কুলার খুঁজুন (Refresh)"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/heroCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#fef9c3"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_hint"
        android:inputType="text"
        android:textSize="14sp"
        android:layout_margin="8dp"
        android:background="@drawable/card_bg"
        android:padding="10dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/typeChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:id="@+id/qualChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />
    </HorizontalScrollView>

    <!-- Filter row: two clean dropdown buttons (single ▼ in the label),
         a pill toggle for shortlist, and a small clear button.
         Spinners were removed: their OEM chrome drew a phantom second
         arrow and a stray gray circle in this row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">
        <Button
            android:id="@+id/sortBtn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/dropdown_bg"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:gravity="center" />
        <Button
            android:id="@+id/gradeBtn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/dropdown_bg"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginLeft="8dp" />
        <ToggleButton
            android:id="@+id/shortlistOnly"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:textOn="★ আমার তালিকা"
            android:textOff="★ আমার তালিকা"
            android:text="★ আমার তালিকা"
            android:textSize="13sp"
            android:layout_marginLeft="8dp" />
        <Button
            android:id="@+id/clearFilters"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/btn_ghost"
            android:textColor="@color/text_dark"
            android:text="✕"
            android:textSize="13sp"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

    <!-- List area: the spinner and the empty message are centred inside
         this frame. Before, the ProgressBar sat after the weight-1
         ListView in the vertical layout, so on first load it rendered
         at the very bottom of the screen, and the empty message did too. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="কোনো সার্কুলার পাওয়া যায়নি।"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/green_dark"
        android:titleTextColor="#ffffff"
        android:titleTextAppearance="@style/ToolbarTitle"
        android:title="@string/profile_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">
            <ImageView
                android:id="@+id/photoPreview"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:visibility="gone" />
            <Button
                android:id="@+id/photoBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:text="ছবি বেছে নিন (Choose Photo)"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_ghost"
                android:textColor="@color/text_dark"
            />
            <EditText
                android:id="@+id/pName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="নাম"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <EditText
                android:id="@+id/pPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="মোবাইল নম্বর"
                android:inputType="phone"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <EditText
                android:id="@+id/pDistrict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="জেলা (যেমন: ঢাকা)"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <EditText
                android:id="@+id/pDob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="জন্ম তারিখ (যেমন: 2000-01-15)"
                android:inputType="date"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="শিক্ষাগত যোগ্যতা (Education)"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/pEduBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:minHeight="0dp"
                android:background="@drawable/dropdown_bg"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:gravity="left|center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="HSC ▼"
                android:layout_marginTop="4dp" />
            <EditText
                android:id="@+id/pTypeBn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="টাইপিং — বাংলা (শব্দ/মিনিট)"
                android:inputType="number"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <EditText
                android:id="@+id/pTypeEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="টাইপিং — ইংরেজি (শব্দ/মিনিট)"
                android:inputType="number"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <EditText
                android:id="@+id/pAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="বর্তমান ঠিকানা"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <!-- Extra CV fields: the website profile has every field a CV
                 has, so the app profile does too. CV upload fills these. -->
            <EditText
                android:id="@+id/pEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ইমেইল (Email)"
                android:inputType="textEmailAddress"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <EditText
                android:id="@+id/pPermAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="স্থায়ী ঠিকানা (Permanent Address)"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <EditText
                android:id="@+id/pFatherName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="পিতার নাম (Father's Name)"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <EditText
                android:id="@+id/pMotherName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="মাতার নাম (Mother's Name)"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <EditText
                android:id="@+id/pSkills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="দক্ষতা (Skills)"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <EditText
                android:id="@+id/pExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="অভিজ্ঞতা (Experience)"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <EditText
                android:id="@+id/pLanguages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ভাষা (Languages)"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />
            <EditText
                android:id="@+id/pNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="অন্যান্য তথ্য (ঐচ্ছিক)"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:padding="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 রিমাইন্ডার পছন্দ (Reminder)"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginTop="18dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আপনি কি চাকরির রিমাইন্ডার পেতে চান?"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">
                <ToggleButton
                    android:id="@+id/remYes"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:textOn="✅ হ্যাঁ, পেতে চাই (Yes)"
                    android:textOff="✅ হ্যাঁ, পেতে চাই (Yes)"
                    android:text="✅ হ্যাঁ, পেতে চাই (Yes)"
                android:minHeight="0dp"
                android:button="@null"
                android:background="@drawable/chip_bg"
                android:textColor="@color/chip_text"
            />
                <ToggleButton
                    android:id="@+id/remNo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:textOn="❌ না, চাই না (No)"
                    android:textOff="❌ না, চাই না (No)"
                    android:text="❌ না, চাই না (No)"
                    android:layout_marginLeft="8dp"
                android:minHeight="0dp"
                android:button="@null"
                android:background="@drawable/chip_bg"
                android:textColor="@color/chip_text"
            />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="কোন ধরনের সার্কুলারের রিমাইন্ডার চান? (Type)"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:textStyle="bold" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="4dp">
                <LinearLayout
                    android:id="@+id/prefTypes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="কোন যোগ্যতার পদের রিমাইন্ডার চান? (Qualification)"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:textStyle="bold" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="4dp">
                <LinearLayout
                    android:id="@+id/prefQuals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- My CV (same as the website's profile page): shows the
                 uploaded CV and lets it be removed from here too. -->
            <TextView
                android:id="@+id/cvInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📄 আমার CV — এখনো কোনো CV আপলোড করা হয়নি।"
                android:textSize="14sp"
                android:textColor="@color/text_grey"
                android:layout_marginTop="18dp" />
            <Button
                android:id="@+id/removeCvBtnProfile"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_ghost"
                android:textColor="#b91c1c"
                android:text="🗑️ CV মুছুন (Remove CV)"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/saveProfileBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="প্রোফাইল সেভ করুন (Save Profile)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_primary"
                android:elevation="2dp"
                android:textColor="#ffffff"
            />
            <!-- Profile reset (same as the website): only the profile + CV
                 are cleared — login/account, shortlist and application
                 status are never touched. Two-tap confirm, no popup. -->
            <Button
                android:id="@+id/resetProfileBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_ghost"
                android:textColor="#b91c1c"
                android:text="↺ প্রোফাইল রিসেট করুন (Reset Profile)"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

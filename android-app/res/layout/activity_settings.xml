<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@drawable/toolbar_bg"
        android:titleTextColor="#ffffff"
        android:titleTextAppearance="@style/ToolbarTitle"
        android:title="@string/settings_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingBottom="32dp">
            <!-- Section cards: each settings group sits on its own white
                 card instead of bare rows on the gray background. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="লেখার সাইজ (Text Size)"
                android:textStyle="bold"
                android:textSize="15sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/sizeSmall"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:text="A-"
                android:minHeight="0dp"
                android:background="@drawable/btn_ghost"
                android:textColor="@color/text_dark"
            />
                <Button
                    android:id="@+id/sizeMedium"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:text="A"
                    android:layout_marginLeft="6dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_ghost"
                android:textColor="@color/text_dark"
            />
                <Button
                    android:id="@+id/sizeLarge"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:text="A+"
                    android:layout_marginLeft="6dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_ghost"
                android:textColor="@color/text_dark"
            />
                <Button
                    android:id="@+id/sizeXl"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:text="A++"
                    android:layout_marginLeft="6dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_ghost"
                android:textColor="@color/text_dark"
            />
            </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="14dp"
                android:layout_marginTop="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CV আপলোড (Upload CV)"
                android:textStyle="bold"
                android:textSize="15sp" />
            <Button
                android:id="@+id/cvBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="CV ফাইল বেছে নিন (Choose CV)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_primary"
                android:elevation="2dp"
                android:textColor="#ffffff"
            />
            <TextView
                android:id="@+id/cvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />
            <Button
                android:id="@+id/cvRemoveBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_ghost"
                android:textColor="#b91c1c"
                android:text="@string/cv_remove"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="14dp"
                android:layout_marginTop="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পুশ নোটিফিকেশন (Push Notification)"
                android:textStyle="bold"
                android:textSize="15sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <ToggleButton
                    android:id="@+id/pushYes"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:textOn="✅ হ্যাঁ, পেতে চাই (Yes)"
                    android:textOff="✅ হ্যাঁ, পেতে চাই (Yes)"
                    android:text="✅ হ্যাঁ, পেতে চাই (Yes)"
                    android:minHeight="0dp"
                    android:background="@drawable/btn_ghost"
                    android:textColor="@color/text_dark"
                />
                <ToggleButton
                    android:id="@+id/pushNo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:textOn="❌ না, চাই না (No)"
                    android:textOff="❌ না, চাই না (No)"
                    android:text="❌ না, চাই না (No)"
                    android:layout_marginLeft="6dp"
                    android:minHeight="0dp"
                    android:background="@drawable/btn_ghost"
                    android:textColor="@color/text_dark"
                />
            </LinearLayout>
            <TextView
                android:id="@+id/pushStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_grey"
                android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="14dp"
                android:layout_marginTop="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="অ্যাপ (App)"
                android:textStyle="bold"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />
            <Button
                android:id="@+id/checkUpdateBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="আপডেট চেক করুন (Check Update)"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/green_dark"
            />
            <TextView
                android:id="@+id/updateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="14dp"
                android:layout_marginTop="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="যোগাযোগ (Contact)"
                android:textStyle="bold"
                android:textSize="15sp" />
            <Button
                android:id="@+id/whatsappBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="📱 WhatsApp-এ যোগাযোগ করুন"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:minHeight="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/green_dark"
            />
            <Button
                android:id="@+id/telegramBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="✈️ Telegram-এ যোগাযোগ করুন"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:minHeight="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/green_dark"
            />
            <TextView
                android:id="@+id/contactEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="অ্যাডমিন এখনো যোগাযোগের তথ্য দেননি।"
                android:textColor="@color/text_grey"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

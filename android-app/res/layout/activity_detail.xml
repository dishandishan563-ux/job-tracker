<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/green_dark"
        android:titleTextColor="#ffffff"
        android:titleTextAppearance="@style/ToolbarTitle"
        android:title="@string/detail_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingBottom="32dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="2dp"
                android:padding="12dp">
                <TextView
                    android:id="@+id/org"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="@color/text_dark" />
                <TextView
                    android:id="@+id/orgEn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_grey"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/metaLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.15" />
                <TextView
                    android:id="@+id/deadlineLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/cdText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_dark" />
                <TextView
                    android:id="@+id/sourceNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_grey"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পদসমূহ (Posts)"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginTop="14dp" />
            <LinearLayout
                android:id="@+id/postsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="2dp"
                android:padding="12dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আমার আবেদনের অবস্থা (My Status)"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginTop="14dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <Button
                    android:id="@+id/statusApplied"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:text="আবেদন করেছি (Applied)" />
                <Button
                    android:id="@+id/statusFee"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:text="ফি দিয়েছি (Fee Paid)"
                    android:layout_marginLeft="6dp" />
                <Button
                    android:id="@+id/statusAdmit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:text="অ্যাডমিট কার্ড (Admit Card)"
                    android:layout_marginLeft="6dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/green_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/applyBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/apply"
                android:textSize="14sp"
                android:layout_marginTop="14dp" />
            <Button
                android:id="@+id/shortlistBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_shortlist"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

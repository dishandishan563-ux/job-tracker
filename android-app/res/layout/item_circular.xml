<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:elevation="2dp"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/org"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.15"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/newBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🆕 নতুন"
            android:textColor="@color/green"
            android:textStyle="bold"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/typeLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_grey"
        android:textSize="13sp"
        android:layout_marginTop="2dp" />
    <TextView
        android:id="@+id/postsLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.15"
        android:layout_marginTop="4dp" />
    <TextView
        android:id="@+id/deadlineLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.15"
        android:layout_marginTop="2dp" />
    <TextView
        android:id="@+id/cdText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/green_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp" />
    <TextView
        android:id="@+id/matchBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓ CV অনুযায়ী মিলেছে"
        android:textColor="@color/green"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginTop="2dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/statusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/green_dark"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginTop="2dp"
        android:visibility="gone" />
    <!-- Slim, balanced action row: Apply is the primary green action,
         Save is a smaller outlined secondary. Both 40dp tall — the old
         huge full-width gray blocks looked heavy and blocky. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Button
            android:id="@+id/applyBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/btn_primary"
            android:elevation="2dp"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="@string/apply" />
        <Button
            android:id="@+id/shortlistBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minHeight="0dp"
            android:minWidth="100dp"
            android:background="@drawable/btn_secondary"
            android:textColor="@color/green_dark"
            android:textSize="13sp"
            android:text="@string/save_shortlist"
            android:layout_marginLeft="8dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/sourceNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_grey"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        android:visibility="gone" />
</LinearLayout>

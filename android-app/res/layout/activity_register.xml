<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@drawable/toolbar_bg"
        android:titleTextColor="#ffffff"
        android:titleTextAppearance="@style/ToolbarTitle"
        android:title="@string/register_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">
            <!-- Brand header: same as the login screen. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/brand_card_bg"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/drawer_logo_bg"
                    android:gravity="center"
                    android:text="JT"
                    android:textColor="@color/green_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:text="@string/app_name"
                    android:textColor="#ffffff"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Form card: name + Gmail + password, register button,
                 back-to-login link. No Google button. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="16dp"
                android:layout_marginTop="12dp">
                <EditText
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="আপনার নাম"
                    android:inputType="textPersonName"
                    android:textSize="14sp"
                    android:background="@drawable/input_bg"
                    android:padding="12dp" />
                <EditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Gmail ঠিকানা"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/input_bg"
                    android:padding="12dp" />
                <EditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="পাসওয়ার্ড (কমপক্ষে ৪ অক্ষর)"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/input_bg"
                    android:padding="12dp" />
                <Button
                    android:id="@+id/registerBtn"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="রেজিষ্ট্রেশন করুন (Register)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:minHeight="0dp"
                    android:background="@drawable/btn_primary"
                    android:elevation="2dp"
                    android:textColor="#ffffff"
                />
                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="14sp"
                    android:textColor="@color/danger" />
                <TextView
                    android:id="@+id/loginLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="অ্যাকাউন্ট আছে? লগইন করুন"
                    android:textColor="@color/green_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="18dp"
                    android:padding="6dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

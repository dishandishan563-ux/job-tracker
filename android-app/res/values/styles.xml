<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/green_dark</item>
        <item name="android:colorPrimaryDark">@color/green_dark</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <!-- Design system (premium pass): one green brand, one title size,
         one body size, one caption size, rounded 12dp cards everywhere. -->
    <style name="Card" parent="">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="ToolbarTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SectionTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>
    <style name="BodyText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>
    <style name="CaptionText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_grey</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light minimal palette (v1.2.3): white background, white cards
         with a 1px light border, ONE muted slate-blue accent (#4a6fa5).
         No gradients, no gold. The old "green_*" names are kept so every
         layout / drawable / Kotlin reference keeps working — their values
         now map to the light minimal system instead of dark. -->
    <!-- Accent: muted slate blue, deepened for contrast on white.
         green_dark is used as text in layouts and as the active-state
         colour, so it must read on white cards. -->
    <color name="green_dark">#4a6fa5</color>
    <color name="green">#4a6fa5</color>
    <color name="green_bright">#4a6fa5</color>
    <color name="green_mid">#3d6390</color>

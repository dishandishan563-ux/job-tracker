<?xml version="1.0" encoding="utf-8"?>
<!-- Update banner background: soft amber card with a warm border, so the
     update notice floats as a card instead of a flat yellow strip. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/amber_bg" />
    <stroke android:width="1dp" android:color="@color/amber_border" />
    <corners android:radius="12dp" />
</shape>

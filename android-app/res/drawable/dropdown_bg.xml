<?xml version="1.0" encoding="utf-8"?>
<!-- Dropdown button (sort / grade): white with light outline, rounded.
     The arrow is part of the button text ("▼"), never the OEM spinner
     chrome — spinners rendered phantom arrows and a stray circle. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#ffffff" />
    <stroke android:width="1dp" android:color="#D8DDE3" />
    <corners android:radius="10dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Premium card background: white, rounded 12dp corners, hairline
     border for definition. Used by every card, input box and panel so
     the whole app has one consistent look. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#ffffff" />
    <stroke android:width="1dp" android:color="#E5E7EB" />
    <corners android:radius="12dp" />
</shape>

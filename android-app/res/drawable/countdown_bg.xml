<?xml version="1.0" encoding="utf-8"?>
<!-- Soft green pill behind badges and the countdown: green text on a
     light-green tint reads as a status badge instead of plain text.
     Used by the countdown, 🆕 badge, CV-match badge and status badge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/green_light" />
    <corners android:radius="8dp" />
</shape>

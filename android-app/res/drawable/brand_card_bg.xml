<?xml version="1.0" encoding="utf-8"?>
<!-- Login brand header (v1.2.0): deeper green gradient, rounded on all
     four corners since it floats as a card (the hero keeps square top
     corners because it sits under the toolbar). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/green_deep"
        android:endColor="@color/green_mid"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Login brand header: same green gradient as the hero, but rounded
     on all four corners since it floats as a card (the hero keeps
     square top corners because it sits under the toolbar). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#14532d"
        android:endColor="#15803d"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>

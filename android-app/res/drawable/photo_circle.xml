<?xml version="1.0" encoding="utf-8"?>
<!-- Circular frame for the profile photo: the ImageView is clipped to
     this oval outline (clipToOutline), so the photo shows as a circle. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#ffffff" />
    <stroke android:width="2dp" android:color="@color/green_light" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar background: subtle vertical green gradient (lighter at the
     top) so the toolbar has depth instead of a flat solid block. Same
     brand green on every screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#166534"
        android:endColor="#14532d"
        android:type="linear" />
</shape>

node_modules
.vercel
.env
.env.local
.env.production
*.log
.DS_Store

# Android release keystore — never commit
android-keystore/

# Native app build outputs (contain the binary APK)
android-app/build/

# PdfBox-Android library jar + its resource assets — local-only binaries,
# same as the keystore (see android-app/libs/README.md)
android-app/libs/*.jar
android-app/assets/
# v1.1.7 vendored libraries (Firebase / Play Services / tess-two) — local-only
# binaries, same as PdfBox (see android-app/libs/README.md)
android-app/libs/vendor/
android-app/libs/aar-res/
android-app/libs/aar-jni/
# google-services.json (Firebase config) — local-only, never commit
android-app/google-services.json
